# Vorlage für die Umgebungsvariablen des eigenen Supabase-Projekts.
# Kopieren nach .env.local (NICHT ins Git-Repo aufnehmen) und die
# Platzhalter <...> durch die echten Werte ersetzen.
#
# Fundort der Werte im neuen Projekt:
#   Supabase-Dashboard > Project Settings > API  (URL, Keys)
#   Supabase-Dashboard > Project Settings > General (Project ID / Reference)
#   Supabase-Dashboard > Project Settings > Database (Connection String)

# --- Serverseitig (nur Backend, nie im Browser) ---
# Projekt-Referenz, z. B. abcdefghijklmnopqrst
SUPABASE_PROJECT_ID=<project-ref>
# https://<project-ref>.supabase.co
SUPABASE_URL=<https://project-ref.supabase.co>
# Project Settings > API > publishable / anon key (darf öffentlich sein)
SUPABASE_PUBLISHABLE_KEY=<publishable-key>
# Project Settings > API > service_role / secret key – GEHEIM,
# ausschließlich in .env.local, niemals im Repo oder im Chat.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# --- Clientseitig (wird in den Browser gebündelt) ---
VITE_SUPABASE_PROJECT_ID=<project-ref>
VITE_SUPABASE_URL=<https://project-ref.supabase.co>
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-key>

# --- KI-Anbieter: OpenAI (ChatGPT) ---
# https://platform.openai.com/api-keys
OPENAI_API_KEY=<openai-api-key>
# Optional: nur setzen, falls ein anderer Endpunkt/Proxy genutzt wird.
# Standard: https://api.openai.com/v1
OPENAI_BASE_URL=
# Nur für scripts/dev-db.mjs (Dev-DB einrichten): Connection string des DEV-Projekts.
# Das Skript verweigert URLs, die nicht SUPABASE_PROJECT_ID_dev enthalten.
SUPABASE_DB_URL_dev=<postgresql://postgres.DEVREF:PASSWORT@HOST:5432/postgres>
# Nur für drizzle-kit (Migrationen von der Kommandozeile):
# Project Settings > Database > Connection string (URI, Session Pooler)
LOVABLE_DB_MIGRATION_URL=<postgresql://postgres:PASSWORT@HOST:5432/postgres>
